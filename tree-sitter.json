{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "luau",
      "camelcase": "Luau",
      "scope": "source.luau",
      "path": ".",
      "external-files": ["common/scanner.h"],
      "file-types": ["luau"],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "locals": "queries/locals.scm",
      "injection-regex": "^luau$"
    },
    {
      "name": "luaux",
      "camelcase": "LuauX",
      "scope": "source.luaux",
      "path": "luaux",
      "external-files": ["common/scanner.h"],
      "file-types": ["luaux"],
      "highlights": ["queries/highlights.scm", "luaux/queries/highlights.scm"],
      "injections": ["queries/injections.scm", "luaux/queries/injections.scm"],
      "locals": ["queries/locals.scm", "luaux/queries/locals.scm"],
      "injection-regex": "^luaux$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for Luau",
    "authors": [
      {
        "name": "ohirume",
        "email": "0uhirume@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/0hirume/tree-sitter-luau"
    }
  },
  "bindings": {
    "c": true
  }
}
